<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>RoyalApps.RoyalTerminal.Rendering.Skia</PackageId>
    <Description>SkiaSharp terminal rendering core independent of Avalonia controls.</Description>
    <IsPackable>true</IsPackable>
    <PackageLicenseExpression>MIT AND OFL-1.1</PackageLicenseExpression>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoyalTerminal.Shaders\RoyalTerminal.Shaders.csproj" />
    <ProjectReference Include="..\RoyalTerminal.Rendering.Text\RoyalTerminal.Rendering.Text.csproj" />
    <ProjectReference Include="..\RoyalTerminal.Terminal\RoyalTerminal.Terminal.csproj" />
    <ProjectReference Include="..\RoyalTerminal.Unicode\RoyalTerminal.Unicode.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <Compile Include="..\Shared\BoundedSkiaPngDecoder.cs" Link="Imaging\BoundedSkiaPngDecoder.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts\JetBrainsMono-Regular.ttf" LogicalName="RoyalTerminal.Fonts.JetBrainsMono-Regular.ttf" />
    <EmbeddedResource Include="Fonts\JetBrainsMono-OFL.txt" LogicalName="RoyalTerminal.Fonts.JetBrainsMono-OFL.txt" />
    <None Update="Fonts\JetBrainsMono-OFL.txt" Pack="true" PackagePath="licenses/JetBrainsMono-OFL.txt" />
    <None Update="Fonts\README.md" Pack="true" PackagePath="licenses/JetBrainsMono-README.md" />
  </ItemGroup>

  <ItemGroup Condition="'$(RoyalTerminalEnablePretextTextPipeline)' == 'true'">
    <PackageReference Include="Pretext" />
    <PackageReference Include="Pretext.Contracts" />
    <PackageReference Include="Pretext.SkiaSharp" />
  </ItemGroup>

</Project>
