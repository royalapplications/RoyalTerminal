<Project>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <_RoyalTerminalGhosttyNativeOSX Include="$(MSBuildThisFileDirectory)../runtimes/osx-arm64/native/*"
                                    Condition="'$(RuntimeIdentifier)' == 'osx-arm64' Or ('$(RuntimeIdentifier)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64')" />
    <_RoyalTerminalGhosttyNativeOSX Include="$(MSBuildThisFileDirectory)../runtimes/osx-x64/native/*"
                                    Condition="'$(RuntimeIdentifier)' == 'osx-x64' Or ('$(RuntimeIdentifier)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64')" />
    <NativeLibrary Include="@(_RoyalTerminalGhosttyNativeOSX)" />
    <!-- Copy only this package's libraries. NativeLibrary is shared with other packages, whose items may be linker inputs that are not files to copy. -->
    <None Include="@(_RoyalTerminalGhosttyNativeOSX)"
          CopyToOutputDirectory="PreserveNewest"
          Link="%(Filename)%(Extension)"
          Visible="false" />
  </ItemGroup>
</Project>
