<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>RoyalApps.RoyalTerminal.Avalonia.App</PackageId>
    <AssemblyTitle>RoyalTerminal</AssemblyTitle>
    <Product>RoyalTerminal</Product>
    <Description>Reusable RoyalTerminal Avalonia application shell with window chrome, native menus, settings, capture replay UI, and multi-session terminal workflows.</Description>
    <PackageProjectUrl>https://github.com/royalapplications/RoyalTerminal</PackageProjectUrl>
    <RepositoryUrl>https://github.com/royalapplications/RoyalTerminal</RepositoryUrl>
    <PackageTags>terminal;avalonia;app-shell;native-menu;pty;ssh</PackageTags>
    <IsPackable>true</IsPackable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Runtime platform checks handle cross-platform safety. -->
    <!-- NU1608 is limited to the SshNet.Agent compatibility bridge until it declares SSH.NET 2026 support. -->
    <NoWarn>$(NoWarn);CA1416;NU1608;NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoyalTerminal.Shaders\RoyalTerminal.Shaders.csproj" />
    <ProjectReference Include="..\RoyalTerminal.Avalonia\RoyalTerminal.Avalonia.csproj" />
    <ProjectReference Include="..\RoyalTerminal.Avalonia.Settings\RoyalTerminal.Avalonia.Settings.csproj" />
    <ProjectReference Include="..\RoyalTerminal.GhosttySharp\RoyalTerminal.GhosttySharp.csproj" />
    <ProjectReference Include="..\RoyalTerminal.Terminal.Vt.Ghostty\RoyalTerminal.Terminal.Vt.Ghostty.csproj" />
    <ProjectReference Include="..\RoyalTerminal.Terminal.Transport.Ssh.SshNet.Agent\RoyalTerminal.Terminal.Transport.Ssh.SshNet.Agent.csproj" />
    <ProjectReference Include="..\RoyalTerminal.Terminal.Transport.Raw\RoyalTerminal.Terminal.Transport.Raw.csproj" />
    <ProjectReference Include="..\RoyalTerminal.Terminal.Transport.Telnet\RoyalTerminal.Terminal.Transport.Telnet.csproj" />
    <ProjectReference Include="..\RoyalTerminal.Terminal.Transport.Serial\RoyalTerminal.Terminal.Transport.Serial.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="ReactiveUI.Reactive" />
    <PackageReference Include="ReactiveUI.Avalonia.Reactive" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="Xaml.Behaviors.Avalonia" />
  </ItemGroup>

  <!-- Universal macOS host bridge, independent of which VT engine is selected. -->
  <ItemGroup>
    <None Remove="runtimes/osx/native/libroyalterminal-notifications.dylib" />
    <None Include="runtimes/osx/native/libroyalterminal-notifications.dylib" Pack="true" PackagePath="runtimes/osx/native/"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="libroyalterminal-notifications.dylib"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) Or Exists('runtimes/osx/native/libroyalterminal-notifications.dylib')" />
  </ItemGroup>
  <Target Name="BuildMacOsNotificationBridge" BeforeTargets="PrepareForBuild"
          Inputs="$(MSBuildProjectDirectory)/../../native/macos-notifications/notifications.m;$(MSBuildProjectDirectory)/../../native/macos-notifications/notifications.h;$(MSBuildProjectDirectory)/../../scripts/build-macos-notifications.sh"
          Outputs="$(MSBuildProjectDirectory)/runtimes/osx/native/libroyalterminal-notifications.dylib"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/../../scripts/build-macos-notifications.sh&quot;" />
  </Target>
  <Target Name="RequireMacOsNotificationBridgeForPack" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/runtimes/osx/native/libroyalterminal-notifications.dylib')"
           Text="Build the macOS notification bridge with scripts/build-macos-notifications.sh on macOS (or download its CI artifact) before packing." />
  </Target>
  <PropertyGroup>
    <NotificationBridgeArch Condition="'$(RuntimeIdentifier)' == 'win-arm64' Or ('$(RuntimeIdentifier)' == '' And '$(PROCESSOR_ARCHITECTURE)' == 'ARM64')">arm64</NotificationBridgeArch>
    <NotificationBridgeArch Condition="'$(NotificationBridgeArch)' == ''">x64</NotificationBridgeArch>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="runtimes/win-x64/native/royalterminal-notifications.dll;runtimes/win-arm64/native/royalterminal-notifications.dll" />
    <None Include="runtimes/win-x64/native/royalterminal-notifications.dll" Pack="true" PackagePath="runtimes/win-x64/native/"
          Condition="Exists('runtimes/win-x64/native/royalterminal-notifications.dll') Or ($([MSBuild]::IsOSPlatform('Windows')) And '$(NotificationBridgeArch)' == 'x64')">
      <TargetPath>royalterminal-notifications.dll</TargetPath>
      <CopyToOutputDirectory Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(NotificationBridgeArch)' == 'x64'">PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(NotificationBridgeArch)' == 'x64'">PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="runtimes/win-arm64/native/royalterminal-notifications.dll" Pack="true" PackagePath="runtimes/win-arm64/native/"
          Condition="Exists('runtimes/win-arm64/native/royalterminal-notifications.dll') Or ($([MSBuild]::IsOSPlatform('Windows')) And '$(NotificationBridgeArch)' == 'arm64')">
      <TargetPath>royalterminal-notifications.dll</TargetPath>
      <CopyToOutputDirectory Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(NotificationBridgeArch)' == 'arm64'">PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(NotificationBridgeArch)' == 'arm64'">PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <Target Name="BuildWindowsNotificationBridge" BeforeTargets="PrepareForBuild"
          Inputs="$(MSBuildProjectDirectory)/../../native/windows-notifications/notifications.cpp;$(MSBuildProjectDirectory)/../../native/windows-notifications/notification-platform.h;$(MSBuildProjectDirectory)/../../scripts/build-windows-notifications.ps1"
          Outputs="$(MSBuildProjectDirectory)/runtimes/win-$(NotificationBridgeArch)/native/royalterminal-notifications.dll"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../scripts/build-windows-notifications.ps1&quot; -Arch $(NotificationBridgeArch)" />
  </Target>
  <Target Name="RequireWindowsNotificationBridgeForPack" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/runtimes/win-x64/native/royalterminal-notifications.dll') Or !Exists('$(MSBuildProjectDirectory)/runtimes/win-arm64/native/royalterminal-notifications.dll')"
           Text="Build both Windows notification bridges with scripts/build-windows-notifications.ps1 -Arch x64/arm64 (or download CI artifacts) before packing." />
  </Target>
</Project>
