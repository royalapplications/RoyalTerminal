<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:Avalonia.Controls.Converters"
        xmlns:styles="using:RoyalTerminal.Avalonia.App.Styles">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="PopupChromeAcrylicBackgroundBrush" Color="#C5F8F8F8" />
          <SolidColorBrush x:Key="PopupChromeAcrylicMenuItemBackgroundPointerOverBrush" Color="#1F000000" />
          <SolidColorBrush x:Key="PopupChromeAcrylicMenuItemBackgroundPressedBrush" Color="#2B000000" />
          <SolidColorBrush x:Key="PopupChromeTopLevelMenuItemBackgroundPointerOverBrush" Color="#14000000" />
          <SolidColorBrush x:Key="PopupChromeTopLevelMenuItemBackgroundPressedBrush" Color="#1F000000" />
          <SolidColorBrush x:Key="PopupChromeTopLevelMenuItemBorderPointerOverBrush" Color="#24000000" />
          <SolidColorBrush x:Key="PopupChromeMenuForegroundBrush" Color="#1F1F1F" />
          <SolidColorBrush x:Key="PopupChromeMenuItemForegroundDisabledBrush" Color="#99000000" />
          <SolidColorBrush x:Key="PopupChromeMenuSeparatorBrush" Color="#33000000" />
          <SolidColorBrush x:Key="PopupChromeMenuCheckedIconBackgroundBrush" Color="#1FFF6A00" />
          <SolidColorBrush x:Key="PopupChromeMenuCheckedIconBorderBrush" Color="#FFFF6A00" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#C5F8F8F8" />
          <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#1F1F1F" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#1F1F1F" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#1F1F1F" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#99000000" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#99000000" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="#99000000" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed" Color="#99000000" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled" Color="#66000000" />
          <SolidColorBrush x:Key="MenuFlyoutSubItemChevron" Color="#99000000" />
          <SolidColorBrush x:Key="MenuFlyoutSubItemChevronPointerOver" Color="#99000000" />
          <SolidColorBrush x:Key="MenuFlyoutSubItemChevronPressed" Color="#99000000" />
          <SolidColorBrush x:Key="MenuFlyoutSubItemChevronDisabled" Color="#66000000" />
          <SolidColorBrush x:Key="MenuFlyoutSubItemChevronSubMenuOpened" Color="#99000000" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#1F000000" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#2B000000" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundSubMenuOpened" Color="#1F000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PopupChromeAcrylicBackgroundBrush" Color="#C5303030" />
          <SolidColorBrush x:Key="PopupChromeAcrylicMenuItemBackgroundPointerOverBrush" Color="#2EFFFFFF" />
          <SolidColorBrush x:Key="PopupChromeAcrylicMenuItemBackgroundPressedBrush" Color="#3AFFFFFF" />
          <SolidColorBrush x:Key="PopupChromeTopLevelMenuItemBackgroundPointerOverBrush" Color="#20FFFFFF" />
          <SolidColorBrush x:Key="PopupChromeTopLevelMenuItemBackgroundPressedBrush" Color="#2AFFFFFF" />
          <SolidColorBrush x:Key="PopupChromeTopLevelMenuItemBorderPointerOverBrush" Color="#52FFFFFF" />
          <SolidColorBrush x:Key="PopupChromeMenuForegroundBrush" Color="#F2F2F2" />
          <SolidColorBrush x:Key="PopupChromeMenuItemForegroundDisabledBrush" Color="#66FFFFFF" />
          <SolidColorBrush x:Key="PopupChromeMenuSeparatorBrush" Color="#33FFFFFF" />
          <SolidColorBrush x:Key="PopupChromeMenuCheckedIconBackgroundBrush" Color="#33FF6A00" />
          <SolidColorBrush x:Key="PopupChromeMenuCheckedIconBorderBrush" Color="#FFFF6A00" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#C5303030" />
          <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#F2F2F2" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#66FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#B3FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled" Color="#66FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutSubItemChevron" Color="#B3FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutSubItemChevronPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutSubItemChevronPressed" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutSubItemChevronDisabled" Color="#66FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutSubItemChevronSubMenuOpened" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#2EFFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#3AFFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundSubMenuOpened" Color="#2EFFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <Thickness x:Key="PopupChromeMenuPopupPadding">4</Thickness>
      <Thickness x:Key="PopupChromeMenuItemPadding">0,6</Thickness>
      <CornerRadius x:Key="PopupChromeMenuItemCornerRadius">5</CornerRadius>
      <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="SystemControlTransparentBrush" />
      <Thickness x:Key="MenuFlyoutPresenterBorderThemeThickness">0</Thickness>
      <StaticResource x:Key="MenuFlyoutItemBackground" ResourceKey="SystemControlTransparentBrush" />
      <StaticResource x:Key="MenuFlyoutItemBackgroundDisabled" ResourceKey="SystemControlTransparentBrush" />
      <Thickness x:Key="MenuFlyoutPresenterThemePadding">4</Thickness>
      <Thickness x:Key="MenuFlyoutItemThemePadding">0,6</Thickness>
      <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">0,6</Thickness>
      <Thickness x:Key="HorizontalMenuFlyoutItemThemePaddingNarrow">8,4</Thickness>
      <Thickness x:Key="HorizontalMenuFlyoutItemMargin">0</Thickness>
      <Thickness x:Key="MenuFlyoutScrollerMargin">0</Thickness>
      <Thickness x:Key="MenuIconPresenterMargin">0,0,8,0</Thickness>
      <Thickness x:Key="MenuInputGestureTextMargin">16,0,0,0</Thickness>
      <Thickness x:Key="MenuFlyoutItemChevronMargin">8,0,0,0</Thickness>
      <x:Double x:Key="PopupChromeMenuItemIconColumnWidth">36</x:Double>
      <x:Double x:Key="PopupChromeMenuItemPopupColumnWidth">30</x:Double>
      <x:Double x:Key="PopupChromeMenuItemCheckGlyphSize">12</x:Double>
      <x:Double x:Key="PopupChromeMenuItemChevronGlyphSize">12</x:Double>
      <CornerRadius x:Key="MenuFlyoutItemCornerRadius">5</CornerRadius>
      <x:Double x:Key="MenuFlyoutSubItemPopupHorizontalOffset">4</x:Double>
      <conv:PlatformKeyGestureConverter x:Key="PopupChromeKeyGestureConverter" />
      <StaticResource x:Key="CheckMarkPathData" ResourceKey="Icon.CheckmarkRegular" />
      <StaticResource x:Key="MenuItemChevronPathData" ResourceKey="Icon.ChevronRightRegular" />

      <ControlTheme x:Key="PopupChromeSeparatorTheme" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource PopupChromeMenuSeparatorBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="PopupChromeEnabledMenuFlyoutPresenterTheme" TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource {x:Type MenuFlyoutPresenter}}">
        <Setter Property="Background" Value="{DynamicResource PopupChromeAcrylicBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource PopupChromeMenuPopupPadding}" />
        <Setter Property="MaxWidth" Value="{DynamicResource FlyoutThemeMaxWidth}" />
        <Setter Property="MinHeight" Value="{DynamicResource MenuFlyoutThemeMinHeight}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            Theme="{StaticResource FluentMenuScrollViewer}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                <ItemsPresenter Name="PART_ItemsPresenter"
                                Grid.IsSharedSizeScope="True"
                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                KeyboardNavigation.TabNavigation="Continue"
                                Margin="{TemplateBinding Padding}" />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="PopupChromeEnabledContextMenuTheme" TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}">
        <Setter Property="Background" Value="{DynamicResource PopupChromeAcrylicBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource PopupChromeMenuPopupPadding}" />
        <Setter Property="WindowManagerAddShadowHint" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            Theme="{StaticResource FluentMenuScrollViewer}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                <ItemsPresenter Name="PART_ItemsPresenter"
                                Grid.IsSharedSizeScope="True"
                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                KeyboardNavigation.TabNavigation="Continue"
                                Margin="{TemplateBinding Padding}" />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="PopupChromeMenuItemTheme" TargetType="MenuItem">
        <Setter Property="Background" Value="{DynamicResource MenuFlyoutItemBackground}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource PopupChromeMenuItemCornerRadius}" />
        <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForeground}" />
        <Setter Property="Padding" Value="{DynamicResource PopupChromeMenuItemPadding}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="{DynamicResource PopupChromeMenuItemIconColumnWidth}" Width="Auto" SharedSizeGroup="MenuItemIconColumnGroup" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup" />
                <ColumnDefinition MinWidth="{DynamicResource PopupChromeMenuItemPopupColumnWidth}" Width="Auto" SharedSizeGroup="MenuItemPopupArrowColumnGroup" />
              </Grid.ColumnDefinitions>

              <Border x:Name="PART_LayoutRoot"
                      Grid.ColumnSpan="4"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}" />

              <Border x:Name="PART_CheckedBorder"
                      BorderThickness="1"
                      Padding="2"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                <Panel Width="16" Height="16">
                  <Viewbox x:Name="PART_IconHost"
                           StretchDirection="DownOnly"
                           IsVisible="False">
                    <ContentControl x:Name="PART_IconPresenter"
                                    Content="{TemplateBinding Icon}" />
                  </Viewbox>
                </Panel>
              </Border>

              <ContentPresenter x:Name="PART_HeaderPresenter"
                                Grid.Column="1"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                Padding="{TemplateBinding Padding}"
                                VerticalAlignment="Center" />

              <TextBlock x:Name="PART_InputGestureText"
                         Grid.Column="2"
                         Margin="35,0,0,0"
                         FontSize="12"
                         Text="{TemplateBinding InputGesture, Converter={StaticResource PopupChromeKeyGestureConverter}}"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}" />

              <PathIcon x:Name="PART_ChevronPath"
                        Grid.Column="3"
                        Width="{DynamicResource PopupChromeMenuItemChevronGlyphSize}"
                        Height="{DynamicResource PopupChromeMenuItemChevronGlyphSize}"
                        Data="{StaticResource Icon.ChevronRightRegular}"
                        Foreground="{DynamicResource MenuFlyoutSubItemChevron}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />

              <Popup x:Name="PART_Popup"
                     Grid.ColumnSpan="4"
                     WindowManagerAddShadowHint="False"
                     HorizontalOffset="{DynamicResource MenuFlyoutSubItemPopupHorizontalOffset}"
                     IsLightDismissEnabled="False"
                     IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                     Placement="RightEdgeAlignedTop">
                <Border Background="{DynamicResource PopupChromeAcrylicBackgroundBrush}"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="5">
                  <ScrollViewer Background="{DynamicResource PopupChromeAcrylicBackgroundBrush}"
                                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                Theme="{StaticResource FluentMenuScrollViewer}"
                                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    Grid.IsSharedSizeScope="True"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    KeyboardNavigation.TabNavigation="Continue"
                                    Margin="{DynamicResource PopupChromeMenuPopupPadding}" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
          <Setter Property="RecognizesAccessKey" Value="True" />
        </Style>

        <Style Selector="^:icon /template/ Viewbox#PART_IconHost">
          <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:checked">
          <Style Selector="^ /template/ Viewbox#PART_IconHost">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <Style Selector="^:not(:icon) /template/ ContentControl#PART_IconPresenter">
            <Setter Property="Content">
              <Template>
                <PathIcon Foreground="{Binding $parent[MenuItem].Foreground}"
                          Width="{DynamicResource PopupChromeMenuItemCheckGlyphSize}"
                          Height="{DynamicResource PopupChromeMenuItemCheckGlyphSize}"
                          Data="{StaticResource Icon.CheckmarkRegular}" />
              </Template>
            </Setter>
          </Style>
          <Style Selector="^:not(:icon):radio /template/ ContentControl#PART_IconPresenter">
            <Setter Property="Content">
              <Template>
                <Ellipse Fill="{Binding $parent[MenuItem].Foreground}"
                         Width="8"
                         Height="8"
                         Margin="4" />
              </Template>
            </Setter>
          </Style>
          <Style Selector="^:icon /template/ Border#PART_CheckedBorder">
            <Setter Property="Background" Value="{DynamicResource PopupChromeMenuCheckedIconBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PopupChromeMenuCheckedIconBorderBrush}" />
            <Setter Property="CornerRadius" Value="4" />
          </Style>
        </Style>

        <Style Selector="^:selected">
          <Style Selector="^ /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource MenuFlyoutItemBackgroundPointerOver}" />
          </Style>
          <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundPointerOver}" />
          </Style>
          <Style Selector="^ /template/ TextBlock#PART_InputGestureText">
            <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver}" />
          </Style>
          <Style Selector="^ /template/ PathIcon#PART_ChevronPath">
            <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutSubItemChevronPointerOver}" />
          </Style>
        </Style>

        <Style Selector="^:pressed /template/ Border#PART_LayoutRoot:pointerover">
          <Setter Property="Background" Value="{DynamicResource MenuFlyoutItemBackgroundPressed}" />
          <Style Selector="^ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundPressed}" />
          </Style>
          <Style Selector="^ TextBlock#PART_InputGestureText">
            <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed}" />
          </Style>
          <Style Selector="^ PathIcon#PART_ChevronPath">
            <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutSubItemChevronPressed}" />
          </Style>
        </Style>

        <Style Selector="^:disabled">
          <Style Selector="^ /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource MenuFlyoutItemBackgroundDisabled}" />
          </Style>
          <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundDisabled}" />
          </Style>
          <Style Selector="^ /template/ TextBlock#PART_InputGestureText">
            <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled}" />
          </Style>
          <Style Selector="^ /template/ PathIcon#PART_ChevronPath">
            <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutSubItemChevronDisabled}" />
          </Style>
        </Style>

        <Style Selector="^:open /template/ PathIcon#PART_ChevronPath">
          <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutSubItemChevronSubMenuOpened}" />
        </Style>

        <Style Selector="^:empty /template/ PathIcon#PART_ChevronPath">
          <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:separator">
          <Setter Property="Template">
            <ControlTemplate>
              <Separator Theme="{StaticResource PopupChromeSeparatorTheme}" />
            </ControlTemplate>
          </Setter>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="PopupChromeTopLevelMenuItemTheme" TargetType="MenuItem" BasedOn="{StaticResource FluentTopLevelMenuItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource PopupChromeMenuItemCornerRadius}" />
        <Setter Property="Foreground" Value="{DynamicResource ToolbarForegroundBrush}" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource PopupChromeMenuItemTheme}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border x:Name="PART_LayoutRoot"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}" />

              <ContentPresenter x:Name="PART_HeaderPresenter"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center" />

              <Popup x:Name="PART_Popup"
                     WindowManagerAddShadowHint="False"
                     MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                     IsLightDismissEnabled="True"
                     IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                     Placement="BottomEdgeAlignedLeft"
                     OverlayInputPassThroughElement="{Binding $parent[Menu]}">
                <Border Background="{DynamicResource PopupChromeAcrylicBackgroundBrush}"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="5">
                  <ScrollViewer Background="{DynamicResource PopupChromeAcrylicBackgroundBrush}"
                                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                Theme="{StaticResource FluentMenuScrollViewer}"
                                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    Grid.IsSharedSizeScope="True"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    KeyboardNavigation.TabNavigation="Continue"
                                    Margin="{DynamicResource PopupChromeMenuPopupPadding}" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Panel>
          </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
          <Setter Property="RecognizesAccessKey" Value="True" />
        </Style>

        <Style Selector="^:selected">
          <Style Selector="^ /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource PopupChromeTopLevelMenuItemBackgroundPointerOverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PopupChromeTopLevelMenuItemBorderPointerOverBrush}" />
          </Style>
          <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ToolbarForegroundBrush}" />
          </Style>
        </Style>

        <Style Selector="^:pressed /template/ Border#PART_LayoutRoot:pointerover">
          <Setter Property="Background" Value="{DynamicResource PopupChromeTopLevelMenuItemBackgroundPressedBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource PopupChromeTopLevelMenuItemBorderPointerOverBrush}" />
        </Style>

        <Style Selector="^:disabled">
          <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{DynamicResource PopupChromeMenuItemForegroundDisabledBrush}" />
          </Style>
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="PopupRoot">
    <Setter Property="styles:PopupRootCornerPreferenceBehavior.IsEnabled" Value="True" />
    <Setter Property="styles:PopupRootThemeVariantBehavior.IsEnabled" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TransparencyBackgroundFallback" Value="Transparent" />
    <Setter Property="TransparencyLevelHint" Value="{styles:PopupTransparencyHint}" />
    <Setter Property="WindowManagerAddShadowHint" Value="False" />
  </Style>

  <Style Selector="PopupRoot Border#PopupBorder">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="PopupRoot">
    <Style.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#C5F8F8F8" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#1F000000" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#2B000000" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundSubMenuOpened" Color="#1F000000" />
            <SolidColorBrush x:Key="PopupChromeMenuCheckedIconBackgroundBrush" Color="#1FFF6A00" />
            <SolidColorBrush x:Key="PopupChromeMenuCheckedIconBorderBrush" Color="#FFFF6A00" />
          </ResourceDictionary>
          <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#C5303030" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#3AFFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundSubMenuOpened" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="PopupChromeMenuCheckedIconBackgroundBrush" Color="#33FF6A00" />
            <SolidColorBrush x:Key="PopupChromeMenuCheckedIconBorderBrush" Color="#FFFF6A00" />
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>

        <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="SystemControlTransparentBrush" />
        <Thickness x:Key="MenuFlyoutPresenterBorderThemeThickness">0</Thickness>
        <StaticResource x:Key="MenuFlyoutItemBackground" ResourceKey="SystemControlTransparentBrush" />
        <StaticResource x:Key="MenuFlyoutItemBackgroundDisabled" ResourceKey="SystemControlTransparentBrush" />
        <Thickness x:Key="MenuFlyoutPresenterThemePadding">4</Thickness>
        <Thickness x:Key="MenuFlyoutItemThemePadding">0,6</Thickness>
        <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">0,6</Thickness>
        <x:Double x:Key="MenuFlyoutSeparatorThemeHeight">1</x:Double>
        <Thickness x:Key="MenuFlyoutSeparatorThemePadding">0,2</Thickness>
        <Thickness x:Key="HorizontalMenuFlyoutItemThemePaddingNarrow">8,4</Thickness>
        <Thickness x:Key="HorizontalMenuFlyoutItemMargin">0</Thickness>
        <Thickness x:Key="MenuFlyoutScrollerMargin">0</Thickness>
        <Thickness x:Key="MenuIconPresenterMargin">0,0,8,0</Thickness>
        <Thickness x:Key="MenuInputGestureTextMargin">16,0,0,0</Thickness>
        <Thickness x:Key="MenuFlyoutItemChevronMargin">8,0,0,0</Thickness>
        <x:Double x:Key="PopupChromeMenuItemIconColumnWidth">36</x:Double>
        <x:Double x:Key="PopupChromeMenuItemPopupColumnWidth">30</x:Double>
        <x:Double x:Key="PopupChromeMenuItemCheckGlyphSize">12</x:Double>
        <x:Double x:Key="PopupChromeMenuItemChevronGlyphSize">12</x:Double>
        <CornerRadius x:Key="MenuFlyoutItemCornerRadius">5</CornerRadius>
        <x:Double x:Key="MenuFlyoutSubItemPopupHorizontalOffset">4</x:Double>
        <StaticResource x:Key="CheckMarkPathData" ResourceKey="Icon.CheckmarkRegular" />
        <StaticResource x:Key="MenuItemChevronPathData" ResourceKey="Icon.ChevronRightRegular" />
      </ResourceDictionary>
    </Style.Resources>
  </Style>

  <Style Selector="Menu#MainMenuBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource PopupChromeTopLevelMenuItemTheme}" />
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="Theme" Value="{StaticResource PopupChromeMenuItemTheme}" />
  </Style>

  <Style Selector="MenuItem PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForeground}" />
  </Style>

  <Style Selector="MenuItem:selected PathIcon, MenuItem:pointerover PathIcon, MenuItem:open PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundPointerOver}" />
  </Style>

  <Style Selector="MenuItem:disabled PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundDisabled}" />
  </Style>

  <Style Selector="NativeMenuBar#MainNativeMenuBar">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="NativeMenuBar#MainNativeMenuBar MenuItem">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="{DynamicResource PopupChromeMenuItemCornerRadius}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ToolbarForegroundBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="NativeMenuBar#MainNativeMenuBar MenuItem:pointerover, NativeMenuBar#MainNativeMenuBar MenuItem:selected, NativeMenuBar#MainNativeMenuBar MenuItem:open">
    <Setter Property="Background" Value="{DynamicResource PopupChromeTopLevelMenuItemBackgroundPointerOverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PopupChromeTopLevelMenuItemBorderPointerOverBrush}" />
  </Style>

  <Style Selector="Menu#MainMenuBar > MenuItem">
    <Setter Property="Theme" Value="{StaticResource PopupChromeTopLevelMenuItemTheme}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="{DynamicResource PopupChromeMenuItemCornerRadius}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ToolbarForegroundBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="Menu#MainMenuBar > MenuItem:pointerover, Menu#MainMenuBar > MenuItem:selected, Menu#MainMenuBar > MenuItem:open">
    <Setter Property="Background" Value="{DynamicResource PopupChromeTopLevelMenuItemBackgroundPointerOverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PopupChromeTopLevelMenuItemBorderPointerOverBrush}" />
  </Style>

  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Theme" Value="{StaticResource PopupChromeEnabledMenuFlyoutPresenterTheme}" />
    <Setter Property="Padding" Value="{DynamicResource PopupChromeMenuPopupPadding}" />
    <Setter Property="Background" Value="{DynamicResource PopupChromeAcrylicBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
  </Style>

  <Style Selector="PopupRoot Menu">
    <Setter Property="Padding" Value="{DynamicResource PopupChromeMenuPopupPadding}" />
    <Setter Property="Background" Value="{DynamicResource PopupChromeAcrylicBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="PopupRoot Menu ScrollViewer">
    <Setter Property="Background" Value="{DynamicResource PopupChromeAcrylicBackgroundBrush}" />
  </Style>

  <Style Selector="ContextMenu">
    <Setter Property="Theme" Value="{StaticResource PopupChromeEnabledContextMenuTheme}" />
    <Setter Property="Padding" Value="{DynamicResource PopupChromeMenuPopupPadding}" />
    <Setter Property="Background" Value="{DynamicResource PopupChromeAcrylicBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="WindowManagerAddShadowHint" Value="False" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
  </Style>

  <Style Selector="PopupRoot MenuItem">
    <Setter Property="Theme" Value="{StaticResource PopupChromeMenuItemTheme}" />
  </Style>

  <Style Selector="PopupRoot Menu MenuItem, PopupRoot MenuFlyoutPresenter MenuItem, PopupRoot ContextMenu MenuItem">
    <Setter Property="Theme" Value="{StaticResource PopupChromeMenuItemTheme}" />
    <Setter Property="Padding" Value="{DynamicResource PopupChromeMenuItemPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource PopupChromeMenuItemCornerRadius}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource PopupChromeMenuForegroundBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="PopupRoot Menu MenuItem:pointerover, PopupRoot MenuFlyoutPresenter MenuItem:pointerover, PopupRoot ContextMenu MenuItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource PopupChromeAcrylicMenuItemBackgroundPointerOverBrush}" />
  </Style>

  <Style Selector="PopupRoot Menu MenuItem:selected, PopupRoot Menu MenuItem:open, PopupRoot MenuFlyoutPresenter MenuItem:selected, PopupRoot MenuFlyoutPresenter MenuItem:open, PopupRoot ContextMenu MenuItem:selected, PopupRoot ContextMenu MenuItem:open">
    <Setter Property="Background" Value="{DynamicResource PopupChromeAcrylicMenuItemBackgroundPointerOverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="PopupRoot Menu MenuItem:pressed, PopupRoot MenuFlyoutPresenter MenuItem:pressed, PopupRoot ContextMenu MenuItem:pressed">
    <Setter Property="Background" Value="{DynamicResource PopupChromeAcrylicMenuItemBackgroundPressedBrush}" />
  </Style>

  <Style Selector="PopupRoot Menu MenuItem:disabled, PopupRoot MenuFlyoutPresenter MenuItem:disabled, PopupRoot ContextMenu MenuItem:disabled">
    <Setter Property="Foreground" Value="{DynamicResource PopupChromeMenuItemForegroundDisabledBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="PopupRoot Separator">
    <Setter Property="Theme" Value="{StaticResource PopupChromeSeparatorTheme}" />
    <Setter Property="Background" Value="{DynamicResource PopupChromeMenuSeparatorBrush}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Height="{TemplateBinding Height}"
                HorizontalAlignment="{TemplateBinding HorizontalAlignment}" />
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="MenuFlyoutPresenter.shell-menu-flyout">
    <Setter Property="Padding" Value="{DynamicResource PopupChromeMenuPopupPadding}" />
    <Setter Property="Background" Value="{DynamicResource PopupChromeAcrylicBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
</Styles>
