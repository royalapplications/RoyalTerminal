<Project>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <_RoyalTerminalGhosttyNativeWin64 Include="$(MSBuildThisFileDirectory)../runtimes/win-x64/native/ghostty-vt.dll"
                                      Condition="Exists('$(MSBuildThisFileDirectory)../runtimes/win-x64/native/ghostty-vt.dll') And ('$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64'))" />
    <_RoyalTerminalGhosttyNativeWin64 Include="$(MSBuildThisFileDirectory)../runtimes/win-x64/native/ghostty-renderer-capi.dll"
                                      Condition="Exists('$(MSBuildThisFileDirectory)../runtimes/win-x64/native/ghostty-renderer-capi.dll') And ('$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64'))" />
    <_RoyalTerminalGhosttyNativeWin64 Include="$(MSBuildThisFileDirectory)../runtimes/win-arm64/native/ghostty-vt.dll"
                                      Condition="Exists('$(MSBuildThisFileDirectory)../runtimes/win-arm64/native/ghostty-vt.dll') And ('$(RuntimeIdentifier)' == 'win-arm64' Or ('$(RuntimeIdentifier)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'))" />
    <_RoyalTerminalGhosttyNativeWin64 Include="$(MSBuildThisFileDirectory)../runtimes/win-arm64/native/ghostty-renderer-capi.dll"
                                      Condition="Exists('$(MSBuildThisFileDirectory)../runtimes/win-arm64/native/ghostty-renderer-capi.dll') And ('$(RuntimeIdentifier)' == 'win-arm64' Or ('$(RuntimeIdentifier)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'))" />
    <NativeLibrary Include="@(_RoyalTerminalGhosttyNativeWin64)" />
    <!-- Copy only this package's libraries. NativeLibrary is shared with other packages, whose items may be bare linker inputs such as dbghelp.lib. -->
    <None Include="@(_RoyalTerminalGhosttyNativeWin64)"
          CopyToOutputDirectory="PreserveNewest"
          Link="%(Filename)%(Extension)"
          Visible="false" />
  </ItemGroup>
</Project>
