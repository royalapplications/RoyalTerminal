<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:RoyalTerminal.Multiplexing.Desktop" x:Class="RoyalTerminal.Multiplexing.Mobile.MobileWorkspaceView" Background="#14171C">
  <UserControl.Styles><Style Selector="Button"><Setter Property="MinHeight" Value="44"/></Style><Style Selector="ComboBox"><Setter Property="MinHeight" Value="44"/></Style></UserControl.Styles>
  <Grid Margin="8" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="5">
    <Grid x:Name="Chrome" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4"><TextBlock Text="RoyalTerminal" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button x:Name="AllowFocus" Grid.Column="1" Content="Allow focus" Click="ToggleRemoteFocus" IsVisible="{Binding #Forget.IsVisible}" AutomationProperties.Name="Allow remote focus for this observer"/><Button x:Name="Forget" Grid.Column="2" Content="Disconnect" Click="ForgetClicked" IsVisible="False"/></Grid>
    <StackPanel x:Name="Credentials" Grid.Row="1" Spacing="5"><TextBlock Text="Server connection" FontWeight="SemiBold"/><TextBox x:Name="Host" PlaceholderText="HTTPS workspace URL" AutomationProperties.Name="Workspace URL"/><TextBox x:Name="Secret" PasswordChar="●" PlaceholderText="Server or share token" AutomationProperties.Name="Workspace token"/><Button x:Name="Connect" Content="Connect" Click="ConnectClicked" HorizontalAlignment="Stretch"/></StackPanel>
    <StackPanel x:Name="Picker" Grid.Row="1" Spacing="5" IsVisible="False"><ComboBox x:Name="Sessions" HorizontalAlignment="Stretch" SelectionChanged="SessionSelected" AutomationProperties.Name="Session"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:WorkspaceSession"><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <ComboBox x:Name="Blocks" HorizontalAlignment="Stretch" AutomationProperties.Name="Terminal"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:WorkspaceBlock"><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="6"><Button x:Name="Observe" Content="Observe" Click="AttachClicked" HorizontalAlignment="Stretch"/><Button x:Name="ControlButton" Grid.Column="1" Content="Take control" Click="AttachClicked" HorizontalAlignment="Stretch"/></Grid>
    </StackPanel>
    <ScrollViewer x:Name="Viewport" Grid.Row="2" Background="#0E1217" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
    <StackPanel x:Name="InputPanel" Grid.Row="3" Spacing="4" IsVisible="False"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="4"><TextBox x:Name="Composer" PlaceholderText="Send literal text" AutomationProperties.Name="Terminal input"/><Button Grid.Column="1" Content="Send" Tag="text" Click="KeyClicked"/></Grid><WrapPanel><Button Content="Esc" Tag="esc" Click="KeyClicked"/><Button Content="Tab" Tag="tab" Click="KeyClicked"/><Button Content="Ctrl+C" Tag="interrupt" Click="KeyClicked"/><Button Content="Enter" Tag="enter" Click="KeyClicked"/></WrapPanel></StackPanel>
    <!-- Status gets the full screen width, even when all three actions are visible. -->
    <StackPanel Grid.Row="4" Spacing="3"><TextBlock x:Name="Notice" Text="Connect to a server to observe a terminal." TextWrapping="Wrap" FontSize="12" Foreground="#B7C3BC"/>
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4" IsVisible="{Binding #Detach.IsVisible}"><Button x:Name="FollowZoom" Grid.Column="0" Content="Follow" Click="FollowWindowZoom" IsVisible="{Binding #Detach.IsVisible}" HorizontalAlignment="Stretch" AutomationProperties.Name="Follow or stop following shared window zoom"/><Button x:Name="Zoom" Grid.Column="1" Content="Zoom" Click="ZoomClicked" IsVisible="False" HorizontalAlignment="Stretch" AutomationProperties.Name="Toggle terminal focus mode"/><Button x:Name="Detach" Grid.Column="2" Content="Detach" Click="DetachClicked" IsVisible="False" HorizontalAlignment="Stretch"/></Grid>
    </StackPanel>
  </Grid>
</UserControl>
