<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:RoyalTerminal.Multiplexing.Desktop" x:Class="RoyalTerminal.Multiplexing.Mobile.MobileWorkspaceView" Background="#10151E">
  <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="8">
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="RoyalTerminal" FontWeight="SemiBold" FontSize="21" VerticalAlignment="Center" /><Button x:Name="Forget" Grid.Column="1" Content="Disconnect" Click="ForgetClicked" IsVisible="False" /></Grid>
    <StackPanel x:Name="Credentials" Grid.Row="1" Spacing="6">
      <TextBox x:Name="Host" PlaceholderText="HTTPS workspace URL" AutomationProperties.Name="Workspace URL" />
      <TextBox x:Name="Secret" PasswordChar="●" PlaceholderText="Workspace token" AutomationProperties.Name="Workspace token" />
      <Button x:Name="Connect" Content="Connect" Click="ConnectClicked" HorizontalAlignment="Stretch" />
    </StackPanel>
    <StackPanel x:Name="Picker" Grid.Row="1" Spacing="5" IsVisible="False">
      <ComboBox x:Name="Sessions" HorizontalAlignment="Stretch" SelectionChanged="SessionSelected" AutomationProperties.Name="Session"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:WorkspaceSession"><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <ComboBox x:Name="Blocks" HorizontalAlignment="Stretch" AutomationProperties.Name="Terminal"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:WorkspaceBlock"><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="6"><Button x:Name="Observe" Content="Observe" Click="AttachClicked" HorizontalAlignment="Stretch" /><Button x:Name="ControlButton" Grid.Column="1" Content="Take control" Click="AttachClicked" HorizontalAlignment="Stretch" /></Grid>
    </StackPanel>
    <ScrollViewer x:Name="Viewport" Grid.Row="2" Background="#0A1018" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
    <StackPanel x:Name="InputPanel" Grid.Row="3" Spacing="5" IsVisible="False"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="4"><TextBox x:Name="Composer" PlaceholderText="Send literal text" /><Button Grid.Column="1" Content="Send" Tag="text" Click="KeyClicked" /></Grid><WrapPanel><Button Content="Esc" Tag="esc" Click="KeyClicked" /><Button Content="Tab" Tag="tab" Click="KeyClicked" /><Button Content="Ctrl+C" Tag="interrupt" Click="KeyClicked" /><Button Content="Enter" Tag="enter" Click="KeyClicked" /></WrapPanel></StackPanel>
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto"><TextBlock x:Name="Notice" Text="Connect to a workspace to observe a terminal." TextWrapping="Wrap" VerticalAlignment="Center" /><Button x:Name="Detach" Grid.Column="1" Content="Detach" Click="DetachClicked" IsVisible="False" /></Grid>
  </Grid>
</UserControl>
