<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:RoyalTerminal.Multiplexing.Desktop.WorkspaceOverview" x:Class="RoyalTerminal.Multiplexing.Desktop.WorkspaceOverview.OverviewWindow" Title="Workspace overview" Width="1080" Height="720" MinWidth="450" MinHeight="300" Background="#10151E">
  <Grid RowDefinitions="Auto,*,Auto" Margin="12" RowSpacing="8">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
      <TextBlock Text="Window" VerticalAlignment="Center" />
      <ComboBox x:Name="WindowsList" Grid.Column="1" MinWidth="130" HorizontalAlignment="Stretch" />
      <TextBlock Grid.Column="2" Text="Observe only" VerticalAlignment="Center" Foreground="#95C7BD" />
    </Grid>
    <views:OverviewPanel x:Name="Surface" Grid.Row="1" ClipToBounds="True" />
    <StackPanel Grid.Row="2" Spacing="4">
      <TextBlock x:Name="ShelfText" TextWrapping="Wrap" Foreground="#A4B0C2" />
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>
