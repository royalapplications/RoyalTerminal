<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:RoyalTerminal.Multiplexing.Desktop.WorkspaceOverview" x:Class="RoyalTerminal.Multiplexing.Desktop.WorkspaceOverview.OverviewWindow" Title="Workspace overview" Width="1080" Height="720" MinWidth="450" MinHeight="300" Background="#10151E" Opened="InitializeEditing">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12" RowSpacing="8">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
      <TextBlock Text="Window" VerticalAlignment="Center"/>
      <ComboBox x:Name="WindowsList" Grid.Column="1" MinWidth="100" HorizontalAlignment="Stretch"/>
      <Button Grid.Column="2" x:Name="ViewConsent" Content="Allow remote focus" Click="ToggleRemoteView" ToolTip.Tip="Let an administrator navigate this overview only; all terminals remain observers"/>
      <Button Grid.Column="3" x:Name="EditToggle" Content="Edit layout…" Click="ToggleEditing" ToolTip.Tip="Edit shared placement without taking terminal control"/>
    </Grid>
    <StackPanel x:Name="EditBar" Grid.Row="1" IsVisible="False" Spacing="5">
      <WrapPanel>
        <ComboBox x:Name="EditSource" MinWidth="120" MaxWidth="200" Margin="0,0,5,3" ToolTip.Tip="Source terminal"/>
        <ComboBox x:Name="EditOperation" MinWidth="125" Margin="0,0,5,3"/>
        <ComboBox x:Name="EditTarget" MinWidth="120" MaxWidth="200" Margin="0,0,5,3" ToolTip.Tip="Target terminal"/>
        <ComboBox x:Name="EditDestination" MinWidth="125" MaxWidth="200" Margin="0,0,5,3" ToolTip.Tip="Destination window"/>
        <TextBox x:Name="EditLabel" PlaceholderText="Name" Width="135" MaxLength="256" Margin="0,0,5,3"/>
        <Button x:Name="ApplyEdit" Content="Apply" Click="ApplyLayoutEdit" Margin="0,0,0,3"/>
      </WrapPanel>
      <TextBlock x:Name="EditHint" Foreground="#A4B0C2" Height="40" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid Grid.Row="2" ClipToBounds="True">
      <views:OverviewPanel x:Name="Surface"/>
      <Border x:Name="GestureLayer" Background="Transparent" IsVisible="{Binding #EditBar.IsVisible}" Focusable="True" PointerPressed="BeginDrag" PointerMoved="MoveDrag" PointerReleased="EndDrag" PointerCaptureLost="GestureCaptureLost"/>
    </Grid>
    <StackPanel Grid.Row="3" Spacing="4"><TextBlock x:Name="ShelfText" TextWrapping="Wrap" Foreground="#A4B0C2"/><TextBlock x:Name="StatusText" TextWrapping="Wrap"/></StackPanel>
  </Grid>
</Window>
